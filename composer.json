{
    "name": "scafera/integration",
    "description": "External system integration for the Scafera framework",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["scafera", "gateway", "integration", "php"],
    "homepage": "https://github.com/scafera/integration",
    "support": {
        "issues": "https://github.com/scafera/integration/issues",
        "source": "https://github.com/scafera/integration"
    },
    "require": {
        "php": ">=8.4",
        "scafera/kernel": "^1.0",
        "symfony/http-client": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Scafera\\Integration\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Scafera\\Integration\\Tests\\": "tests/"
        }
    }
}
